# Fallback Dockerfile for regular .next build (when standalone is not available)
FROM oven/bun:1-alpine AS runtime

# Install minimal runtime dependencies and Next.js
RUN apk add --no-cache curl dumb-init && \
    rm -rf /var/cache/apk/* && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs --ingroup nodejs

WORKDIR /app

# Set environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy package.json and install only production dependencies
COPY --chown=nextjs:nodejs package.json ./
RUN bun install --production --frozen-lockfile --no-cache

# Copy pre-built application files
COPY --chown=nextjs:nodejs .next ./.next
COPY --chown=nextjs:nodejs public ./public

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/ || exit 1

# Start the application
ENTRYPOINT ["dumb-init", "--"]
CMD ["bun", "start"]
