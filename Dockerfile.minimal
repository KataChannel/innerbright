# Ultra-minimal build for 2GB servers
FROM oven/bun:1-alpine AS base

# Install only essential dependencies
RUN apk add --no-cache libc6-compat curl dumb-init && \
    rm -rf /var/cache/apk/* && \
    rm -rf /tmp/*

WORKDIR /app

# Dependencies stage with minimal memory usage
FROM base AS deps
COPY package.json bun.lockb* ./
# Ultra-conservative installation
RUN bun install --frozen-lockfile --no-optional --silent --no-cache --production

# Builder stage with extreme memory optimization
FROM base AS builder
WORKDIR /app

# Copy only production dependencies
COPY --from=deps /app/node_modules ./node_modules

# Copy only essential files
COPY package.json next.config.ts tsconfig.json ./
COPY postcss.config.mjs ./
COPY src ./src
COPY public ./public

# Set ultra-conservative environment
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV SKIP_ENV_VALIDATION=1

# Build with EXTREME memory conservation
RUN NODE_OPTIONS="--max-old-space-size=384 --max-semi-space-size=1 --max-executable-size=64 --optimize-for-size" \
    bun run build && \
    # Immediate cleanup
    find .next -name "*.map" -delete 2>/dev/null || true && \
    rm -rf node_modules/.cache 2>/dev/null || true && \
    rm -rf .next/cache 2>/dev/null || true && \
    rm -rf /tmp/* 2>/dev/null || true

# Ultra-minimal production image
FROM oven/bun:1-alpine AS runner
WORKDIR /app

# Install only runtime essentials
RUN apk add --no-cache curl dumb-init && \
    rm -rf /var/cache/apk/* && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs --ingroup nodejs && \
    mkdir -p .next && chown nextjs:nodejs .next

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy built application with minimal footprint
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

# Ultra-conservative health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=2 \
  CMD curl -f http://localhost:3000/ || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["bun", "server.js"]
