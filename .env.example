# Environment variables for production optimization
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1

# Site configuration
SITE_VERSION=latest
SITE_PORT=3000
RESTART_POLICY=unless-stopped

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MINIO_ENDPOINT=http://localhost:9000

# Logging
LOG_LEVEL=info

# Database Configuration
POSTGRES_DB=innerbright_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# MinIO Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_password_here
MINIO_USE_SSL=false

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@innerbright.vn
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050
