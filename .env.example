# ===========================================
# INNERBRIGHT DOCKER COMPOSE CONFIGURATION
# ===========================================

# Build and Deployment Mode
BUILD_MODE=prebuilt                    # prebuilt (recommended) or build
DOCKERFILE_NAME=Dockerfile             # Dockerfile to use
SITE_VERSION=latest                    # Docker image tag
RESTART_POLICY=unless-stopped          # Container restart policy

# Environment and Build
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ===========================================
# RESOURCE LIMITS (Optimized for 2GB Server)
# ===========================================

# PostgreSQL Resources
POSTGRES_MEMORY_LIMIT=200M             # Max memory for PostgreSQL
POSTGRES_MEMORY_RESERVATION=100M       # Reserved memory for PostgreSQL

# Site Application Resources  
SITE_MEMORY_LIMIT=400M                 # Max memory for Next.js app
SITE_MEMORY_RESERVATION=200M           # Reserved memory for Next.js app
SITE_START_PERIOD=90s                  # Startup grace period

# Redis Resources (when enabled)
REDIS_MEMORY_LIMIT=128M                # Max memory for Redis
REDIS_MEMORY_RESERVATION=64M           # Reserved memory for Redis
REDIS_MAX_MEMORY=64mb                  # Redis internal memory limit

# MinIO Resources (when enabled)
MINIO_MEMORY_LIMIT=256M                # Max memory for MinIO
MINIO_MEMORY_RESERVATION=128M          # Reserved memory for MinIO

# PgAdmin Resources (when enabled)
PGADMIN_MEMORY_LIMIT=256M              # Max memory for PgAdmin
PGADMIN_MEMORY_RESERVATION=128M        # Reserved memory for PgAdmin

# ===========================================
# SERVICE PORTS
# ===========================================
SITE_PORT=3000                         # Main application port
POSTGRES_PORT=5432                     # PostgreSQL port
REDIS_PORT=6379                        # Redis port
MINIO_PORT=9000                        # MinIO API port
MINIO_CONSOLE_PORT=9001                # MinIO console port
PGADMIN_PORT=5050                      # PgAdmin web interface port

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_DB=innerbright               # Database name
POSTGRES_USER=postgres                 # Database user
POSTGRES_PASSWORD=your_secure_password # Database password

# Database URL (auto-generated from above)
DATABASE_URL=postgresql://postgres:your_secure_password@postgres:5432/innerbright

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_PASSWORD=redis_secure_password   # Redis password
REDIS_URL=redis://default:redis_secure_password@redis:6379

# ===========================================
# MINIO (OBJECT STORAGE) CONFIGURATION
# ===========================================
MINIO_ROOT_USER=minio                  # MinIO admin username
MINIO_ROOT_PASSWORD=minio_secure_pass  # MinIO admin password
MINIO_ACCESS_KEY=minio                 # MinIO access key
MINIO_SECRET_KEY=minio_secure_pass     # MinIO secret key
MINIO_ENDPOINT=minio                   # MinIO internal endpoint
MINIO_USE_SSL=false                    # Use SSL for MinIO

# ===========================================
# PGADMIN CONFIGURATION
# ===========================================
PGADMIN_DEFAULT_EMAIL=admin@innerbright.vn        # PgAdmin login email
PGADMIN_DEFAULT_PASSWORD=pgadmin_secure_password  # PgAdmin login password

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
LOG_LEVEL=info                         # Application log level

# Public URLs (Update for production)
NEXT_PUBLIC_APP_URL=https://innerbright.vn              # Public app URL
NEXT_PUBLIC_MINIO_ENDPOINT=https://innerbright.vn/uploads # Public MinIO endpoint

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_MAX_SIZE=5m                        # Maximum log file size
LOG_MAX_FILE=2                         # Maximum number of log files

# Database Configuration
POSTGRES_DB=innerbright_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379

# MinIO Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_USE_SSL=false

# Authentication
NEXTAUTH_SECRET=your_super_secure_nextauth_secret_32_chars_min
NEXTAUTH_URL=https://innerbright.vn

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@innerbright.vn
PGLADMIN_DEFAULT_PASSWORD=your_pgladmin_password_here
PGADMIN_PORT=5050

# SSL Certificate Email (for Let's Encrypt)
SSL_EMAIL=admin@innerbright.vn

# Optional: Performance Tuning
NODE_OPTIONS=--max-old-space-size=1024
MAX_FILE_SIZE=10485760
MAX_FILES_PER_UPLOAD=5

# Optional: Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
